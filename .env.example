# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real tokens/secrets.

# --- Local single-user mode (all you need for Claude Desktop etc.) ---

# GitHub personal access token. Optional - RepoLens works unauthenticated,
# but GitHub rate-limits unauthenticated requests to 60/hour vs 5000/hour
# authenticated. A read-only / fine-grained token is enough: RepoLens
# never writes to GitHub.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Optional overrides (rarely needed):
# GITHUB_API_BASE=https://api.github.com
# REPOLENS_TIMEOUT_SECONDS=30


# --- Hosted, multi-tenant mode only (REPOLENS_TRANSPORT=http) ---
# See README.md "Hosted deployment" for the full walkthrough. Uncomment
# and fill these in only if you're running RepoLens as a shared service.

# REPOLENS_TRANSPORT=http
# REPOLENS_HOST=0.0.0.0
# REPOLENS_PORT=8000
# REPOLENS_PUBLIC_URL=https://repolens.example.com
# REPOLENS_SESSION_DB_PATH=repolens_sessions.db
# REPOLENS_ALLOWED_HOSTS=
# REPOLENS_ALLOWED_ORIGINS=

# From your GitHub OAuth App (Settings -> Developer settings -> OAuth Apps):
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_SCOPES=
